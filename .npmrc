# better-sqlite3 13 ships prebuilt binaries (prebuilds/) and declares "gypfile": false, but `npm ci`
# from the lockfile does not see that flag and falls back to `node-gyp rebuild`, which needs
# Visual Studio C++ build tools. No dependency needs an install script, so skip them all.
# `npm start`, `npm run build` and `npm test` still run normally.
ignore-scripts=true
