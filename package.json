{
  "name": "billable-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local work ledger for time, invoices and direct contribution.",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "release": "tsx scripts/release.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "dev:demo": "vite --config vite.demo.config.ts"
  },
  "dependencies": {
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "adm-zip": "0.6.1",
    "better-sqlite3": "13.0.3",
    "decimal.js": "10.6.0",
    "express": "5.2.1",
    "lucide-react": "1.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@noble/hashes": "2.4.0",
    "@playwright/test": "1.63.0",
    "@types/adm-zip": "0.5.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "6.1.1",
    "buffer": "6.0.3",
    "sql.js": "1.14.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
